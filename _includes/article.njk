<!DOCTYPE html>
<html lang="id">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta name="description" content="{{ description }}">

    <title>{{ title }} - Klinik Putra Medika</title>

    <link rel="stylesheet" href="/style.css">

</head>

<body>

    <header class="navbar">

        <a href="/index.html" class="logo">
            Klinik <span>Putra Medika</span>
        </a>

        <nav>

            <a href="/index.html">
                Beranda
            </a>

            <a href="/kalkulator.html">
                Kalkulator
            </a>

            <a href="/berita.html" class="active">
                Berita
            </a>

            <a href="/edukasi.html">
                Edukasi
            </a>

        </nav>

    </header>


    <main>

        <section class="article-page">

            <article class="article-container">

                {% if category %}
                <span class="content-category">
                    {{ category }}
                </span>
                {% endif %}

                <h1>
                    {{ title }}
                </h1>

                {% if date %}
                <p class="article-meta">
                    {{ date | readableDate }}
                </p>
                {% endif %}

                {% if image %}
                <img
                    src="{{ image }}"
                    alt="{{ title }}"
                    style="
                        width:100%;
                        max-height:450px;
                        object-fit:cover;
                        border-radius:15px;
                        margin-bottom:30px;
                    "
                >
                {% endif %}

                <div class="article-content">

                    {{ content | safe }}

                </div>

                <br>

                <a
                    href="/berita.html"
                    class="card-link"
                >
                    ← Kembali ke Berita
                </a>

            </article>

        </section>


        <section class="disclaimer">

            <h3>
                ⚠️ Catatan penting
            </h3>

            <p>
                Informasi pada website ini ditujukan untuk
                edukasi kesehatan umum dan bukan pengganti
                diagnosis atau konsultasi dengan tenaga
                kesehatan profesional.
            </p>

        </section>

    </main>


    <footer>

        <div class="footer-content">

            <div class="footer-info">

                <h3>
                    Klinik Putra Medika
                </h3>

                <p>
                    Informasi dan edukasi kesehatan
                    untuk masyarakat.
                </p>

            </div>

            <div class="footer-contact">

                <h4>Alamat</h4>

                <p>
                    Kp. Gandasoli, Cikidangbayabang,
                    Kec. Mande, Kabupaten Cianjur,
                    Jawa Barat 43292
                </p>

                <a
                    href="https://maps.app.goo.gl/FBpVHsCqKXm1utNK8"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="maps-button"
                >
                    📍 Lihat Lokasi Klinik
                </a>

                <h4>Telepon</h4>

                <p>
                    <a href="tel:087810353838">
                        0878-1035-3838
                    </a>
                </p>

            </div>

            <div class="footer-copyright">

                <p>
                    © 2026 Klinik Putra Medika
                </p>

            </div>

        </div>

    </footer>

</body>

</html>
