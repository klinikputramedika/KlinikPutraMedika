<article class="news-card">

    {% if image %}
    <img
        src="{{ image }}"
        alt="{{ title }}"
        class="news-image"
    >
    {% else %}
    <div class="news-image">
        🏥
    </div>
    {% endif %}

    <div class="news-content">

        <span class="content-category">
            {{ category }}
        </span>

        <p class="news-date">
            {{ date | date: "%d %B %Y" }}
        </p>

        <h3>
            {{ title }}
        </h3>

        <p>
            {{ description }}
        </p>

        <a
            href="{{ page.url }}"
            class="card-link"
        >
            Baca Selengkapnya →
        </a>

    </div>

</article>
